{
  "expo": {
    "name": "ProNatural Admin",
    "slug": "pronatural-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pronatural.admin",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
      "backgroundColor": "#faf9f6",
        "foregroundImage": "./assets/app-icon-square.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4838b927-e9f9-455e-9d93-24ab809993aa"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f6"
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
